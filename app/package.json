{
  "name": "ai-job-search-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p ../adapter/tsconfig.json && next build",
    "dev": "tsc -p ../adapter/tsconfig.json && next dev",
    "start": "next start",
    "typecheck": "tsc -p ../adapter/tsconfig.json --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@ai-job-search/adapter": "file:../adapter",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.3"
  }
}
